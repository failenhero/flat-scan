# --- Email sending (Brevo SMTP) ---
# Sign up free at https://www.brevo.com, verify a sender under
# Senders, Domains & Dedicated IPs, then open SMTP & API -> SMTP tab.
# SMTP_USER is the "Login" shown there (looks like xxxxxx001@smtp-brevo.com);
# SMTP_PASS is a generated SMTP key (NOT your Brevo account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=xxxxxx001@smtp-brevo.com
SMTP_PASS=xsmtpsib-your-generated-smtp-key
# MAIL_FROM must be an address you verified as a sender in Brevo.
MAIL_FROM=your-verified-sender@example.com
# Where alerts are delivered (any inbox: Proton, Tuta, etc.).
MAIL_TO=you@example.com

# --- Source + behaviour ---
SOURCE_URL=https://bgr.immomio.online/
POLL_INTERVAL_MS=300000
# Included in the outbound User-Agent so the site owner can reach you.
CONTACT_EMAIL=you@example.com
